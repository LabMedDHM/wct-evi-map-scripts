    given-names: Karolina
    affiliation: "Institute of Laboratory Medicine, German Heart Centre Munich, TUM University Hospital"
    # orcid: "https://orcid.org/0000-0000-0000-0000"
version: 1.0.0
date-released: 2026-10-30
license: MIT
keywords:
  - evidence and gap map
  - WHO Classification of Tumours
  - acute myeloid leukaemia
  - B-lymphoblastic leukaemia/lymphoma
  - levels of evidence
  - EPPI-Reviewer
  - WCT EVI MAP
